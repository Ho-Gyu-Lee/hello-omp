# Agent-created working scripts and evidence (not canonical project files)
/.omp-artifacts/

# Local smoke-test deployment targets
.tmp-omp-test*/
.tmp omp test*/

# Backup files produced by setup scripts when targeting a repo-local config dir
*.bak

# omp state if PI_CODING_AGENT_DIR is accidentally pointed at the repo
agent.db*
.DS_Store

# Legacy location of local-only learned concepts, kept ignored as a guard against committing them.
# Local concepts now live in <configdir>/okf/learned/ and never in this clone; setup copies legacy files there once.
# Ignoring does not protect files: git merge/pull overwrite ignored files by default (--overwrite-ignore).
# index.md stays tracked as the local-only policy note; setup replaces <configdir>/okf/learned/index.md with it.
okf/learned/*
!okf/learned/index.md
